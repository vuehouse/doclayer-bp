# DocLayer Dev Envs
DL_DEBUG=false

# DocLayer Production Envs / Security
DL_SECURITY_PROD_LOG=false
DL_SECURITY_CORS_ORIGIN="https://doclayer.dev" # CORS origin(s) for the DocLayer

# DocLayer Search AI Assistant Envs
DL_SEARCH_ASSISTANT=false
DL_SEARCH_ASSISTANT_HFC="https://cdn.jsdelivr.net/npm/@huggingface/transformers@3.4.2/+esm"

# DocLayer Metadata Envs
DL_META_TAG="DocLayer"
DL_META_DOMAIN="https://doclayer.dev"
DL_META_TITLE="The Smart Content Framework powered by Nuxt"
DL_META_DESCRIPTION="Write anything in Markdown, DocLayer handles the rest. Stunningly."
DL_META_KEYWORDS="vue, nuxt, docs, documentation, content, module, layer, framework, template, typescript, javascript, doclayer"
DL_META_AUTHOR="vue.house"
DL_META_ROBOTS="noindex, nofollow"

# DocLayer LLM Metadata Envs 
DL_LLMS_TITLE=
DL_LLMS_DESCRIPTION=

# Nuxt Public Envs (Required for the production builds)
NUXT_PUBLIC_BASE_URL=
NUXT_PUBLIC_SITE_URL=

# Nitro Envs
NITRO_BUILD_TIMEOUT=5000
NITRO_EVENTS=false